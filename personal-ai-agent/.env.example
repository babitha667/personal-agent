# Export these in your shell; .env files are not automatically loaded.
LLM_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_TOKENS=2048

# Set these in your shell; the app does not automatically load .env files.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:0.6b
AGENT_USER_ID=u1
AGENT_TIMEZONE=Asia/Kolkata
# Set to 0 to disable embedded action execution; chat still plans and drains the outbox.
AGENT_WORKER_ENABLED=1
# Native Ollama tool calling. Legacy structured mode is opt-in.
OLLAMA_TOOL_MODE=native
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
AGENT_PLANNING_TIMEOUT_SECONDS=120
OLLAMA_NUM_PREDICT=1024
OLLAMA_NUM_CTX=8192

# Qwen3 0.6B uses native reasoning for reliable tool selection in live checks.
OLLAMA_THINK=1

# Optional isolated database, useful for verification runs.
# AGENT_DB_PATH=/absolute/path/to/agent.db

# Continuous processor runs with main.py. Poll recurrence without calling a model.
AGENT_CONTINUOUS_POLL_SECONDS=5
# Enabled by default for newly registered users; sources read the local SQLite data only.
AGENT_PROACTIVE_ENABLED=1
AGENT_PROACTIVE_INTERVAL_SECONDS=30
# These local sources are defaults for new users; an empty override revokes both.
AGENT_PROACTIVE_SOURCES=email_inbox,reminders

# Optional local mailbox sender; no actual external email delivery.
# If omitted, a stable per-user @local.invalid address is generated.
# AGENT_EMAIL_ADDRESS=me@local.invalid
